x log init yy

GIT_DOMAIN=${GIT_DOMAIN:-$(x websrc gitdomain)}

function work(){
    local num=$1
    local ___X_CMD_YANFA_YY_XX_PREPARE_EXTMETA=
    INPUTS_PREPARE_EXTMETA_VERSION=" ${INPUTS_PREPARE_EXTMETA_VERSION} "
    [ "$INPUTS_PREPARE_EXTMETA_VERSION" = "${INPUTS_PREPARE_EXTMETA_VERSION#*" ${num} "}" ] || ___X_CMD_YANFA_YY_XX_PREPARE_EXTMETA=1

    yy:info "正在准备发布 x$num; ___X_CMD_YANFA_YY_XX_PREPARE_EXTMETA=$___X_CMD_YANFA_YY_XX_PREPARE_EXTMETA"
    (
        # ___x_cmd rmrf "y${num}" || return
        if [ -d "y${num}" ]; then
            yy:info "git pull git@${GIT_DOMAIN}:x-cmd/y${num}.git main"
            git pull "git@${GIT_DOMAIN}:x-cmd/y${num}.git" main || return
        else
            yy:info "git clone git@${GIT_DOMAIN}:x-cmd/y${num}.git main"
            git clone "git@${GIT_DOMAIN}:x-cmd/y${num}.git" || return
        fi
        yy:info "cd y${num}"
        \cd "y$num" || exit

        yy:info "x yanfa yy xx"
        ___x_cmd yanfa yy xx || return $?

        # yy:info "x gitb sync git@github.com:x-cmd/x$num git@codeberg.org:x-cmd/x$num git@gitee.com:x-cmd/x$num"
        # ___x_cmd gitb sync "git@github.com:x-cmd/x$num" "git@codeberg.org:x-cmd/x$num" "git@gitee.com:x-cmd/x$num"
    ) || return $?
    yy:info "成功发布 x$num"
}

[ -z "$INPUTS_VERSION_NUM" ] || eval "set -- $INPUTS_VERSION_NUM"
[ -n "$INPUTS_PREPARE_EXTMETA_VERSION" ] || INPUTS_PREPARE_EXTMETA_VERSION="7 6"
yy:info "INPUTS_PREPARE_EXTMETA_VERSION[$INPUTS_PREPARE_EXTMETA_VERSION]"

if [ $# -eq 0 ]; then
    set -- 0 1 6
fi

for i in "$@"; do
    work "$i" || exit 1
done
